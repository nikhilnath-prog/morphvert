# === DATABASE ===
# Leave blank for Railway no-DB deploy; the app will fall back to SQLite.
DATABASE_URL=
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# === REDIS ===
REDIS_URL=
REDIS_CELERY_URL=

# === JWT & SECURITY ===
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_AUDIENCE=morphvert-api

# === ENVIRONMENT ===
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# === AWS S3 ===
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=morphvert-files

# === STORAGE ===
LOCAL_STORAGE_PATH=uploads
CONVERTED_FILES_PATH=converted
TEMP_FILES_PATH=temp
LOGS_DIR=logs
MAX_FILE_SIZE=52428800  # 50 MB
FILE_RETENTION_DAYS=30

# === FEATURES ===
ENABLE_OCR=True
ENABLE_AI_SUMMARY=True
ENABLE_BATCH_PROCESSING=True
MAX_BATCH_SIZE=100

# === CELERY ===
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# === CORS ===
# Use a JSON array in production, for example: ["https://morphvert.vercel.app"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "https://morphvert.vercel.app"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# === API ===
API_V1_STR=/api/v1
PROJECT_NAME=Morphvert API
PROJECT_VERSION=1.0.0
PROJECT_DESCRIPTION=Advanced File Conversion Platform

# === ADMIN ===
FIRST_SUPERUSER_EMAIL=admin@morphvert.com
FIRST_SUPERUSER_PASSWORD=change-me-in-production

# Optional: required only for the AI PDF Summarizer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
